# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
# Every value here is a local development placeholder: there are no real
# secrets in this repository and no real patient data anywhere in the project.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_only
POSTGRES_DB=clinic
POSTGRES_HOST=localhost
# Published on 5433 by default: 5432 is often taken by a local PostgreSQL.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://clinic:clinic_dev_only@localhost:5433/clinic

# Used by the integration test-suite. If unset, the tests spin up a throwaway
# PostgreSQL container via testcontainers (slower, but needs no running stack).
# Point it at the dedicated `clinic_test` database that docker compose creates
# to make the suite noticeably faster. The fixtures refuse any database whose
# name does not mark it as disposable, since they drop the public schema.
# TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic_dev_only@localhost:5433/clinic_test

# --- Domain backend -------------------------------------------------------
# 0.0.0.0 only inside a container; on the host leave it on loopback.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Where the MCP server reaches the backend (a URL, not a bind address).
BACKEND_BASE_URL=http://127.0.0.1:8000
APP_ENV=development
LOG_LEVEL=INFO

# --- Seed (deterministic mock data) --------------------------------------
SEED_VALUE=20260831
SEED_PACIENTES=60
SEED_DIAS_AGENDA=21

# --- MCP server (M3+) -----------------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8080
MCP_PUBLIC_URL=http://localhost:8080
# Comma-separated list of Origins allowed to reach the MCP transport
# (defence against DNS-rebinding, security layer 5).
MCP_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Bare names are automatically expanded with MCP_PORT (localhost -> localhost:8080),
# because that is the form a browser actually sends in the Host header.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
# Requests per window, per authenticated subject (or per client IP if anonymous).
# Set to false ONLY for local work without an authorization server.
# No session: identity is in the token, pending approvals travel in theirs.
MCP_STATELESS=true
MCP_AUTH_ENABLED=true
MCP_RATE_LIMITE=120
MCP_RATE_VENTANA_SEGUNDOS=60

# --- Human-in-the-loop: MRTR request state -------------------------------
# Seals the paused operation the client carries back with the human's answer.
# Comma-separated key ring: the first seals, all of them unseal, which is what
# makes rotation zero-downtime. Minimum 32 bytes each.
REQUEST_STATE_KEYS=dev-only-request-state-key-change-me-32b
REQUEST_STATE_TTL_SECONDS=300

# --- OAuth 2.1 authorization server (M5) ---------------------------------
OAUTH_HOST=127.0.0.1
OAUTH_ISSUER=http://localhost:9000
OAUTH_AUDIENCE=http://localhost:8080
OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
# Internal URL for fetching the signing keys. Empty = derive from OAUTH_ISSUER.
# In Docker: http://oauth:9000/jwks.json
OAUTH_JWKS_URL=
